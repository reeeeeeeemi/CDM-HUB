# Supabase — Dashboard > Project Settings > API
# Both are safe to expose in the browser: they are protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web Push — générer avec `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# Identité du groupe — tout est optionnel, les valeurs par défaut sont celles
# du CDM. C'est ce qui permet de servir un autre groupe depuis le même code.
NEXT_PUBLIC_GROUP_NAME=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT=
NEXT_PUBLIC_TAGLINE=
NEXT_PUBLIC_DESCRIPTION=
NEXT_PUBLIC_CITIES=Toulouse:🌸,Bordeaux:🍷,Paris:🗼

# Récap du matin — le secret est généré par la migration 0010, à relire avec
#   select value from app_config where key = 'digest_secret';
DIGEST_SECRET=
# Posé par Vercel sur l'appel de la tâche planifiée, pour prouver qu'il vient
# bien de lui. Facultatif : sans lui, la route ne vérifie que DIGEST_SECRET.
CRON_SECRET=
